# ===== 环境变量模板：复制为 .env 并填入真实值；.env 已被 gitignore，永不入库 =====

# ---- LLM 供应商（openai | deepseek | qwen | glm | mock）----
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ---- Embedding 供应商（不配置则降级本地哈希向量，仅能跑通流程无语义能力）----
EMBED_PROVIDER=mock
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=

# ---- 发票查验 API（generic 适配器；不配置则离线规则校验；失败按 fail-closed 处理）----
INVOICE_API_PROVIDER=
INVOICE_API_URL=
INVOICE_API_KEY=

# ---- JWT 签名密钥（生产环境必须为随机长字符串，且与示例不同）----
JWT_SECRET=change-me-to-a-random-256bit-secret
